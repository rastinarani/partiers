# Copy this file to .env.local and fill in real values.

# MongoDB connection string. Locally: mongodb://127.0.0.1:27017
# In production: your MongoDB Atlas connection string.
MONGODB_URI=

# Database name to use.
MONGODB_DB=partiers

# Random secret used to sign admin and customer login cookies. Generate
# one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# There's no admin signup page on purpose. Create an admin account with:
#   npm run create-admin -- "Full Name" you@example.com "a real password"
