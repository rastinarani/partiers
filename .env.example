# Copy this file to .env.local and fill in real values.

# MongoDB connection string. Locally: mongodb://127.0.0.1:27017
# In production: your MongoDB Atlas connection string.
MONGODB_URI=

# Database name to use.
MONGODB_DB=partiers

# Shared password for the /admin dashboard.
ADMIN_PASSWORD=

# Random secret used to sign the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
